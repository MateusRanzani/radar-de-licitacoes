# ─── Banco de dados ───────────────────────────────────────────────────────────
# Local (Docker): postgresql://licitaradar:licitaradar_dev@localhost:5432/licitaradar
# Neon (produção): postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/licitaradar?sslmode=require
DATABASE_URL=postgresql://licitaradar:licitaradar_dev@localhost:5432/licitaradar

# ─── Auth (NextAuth v5) ───────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET=change-me-in-production

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@licitaradar.com.br

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
