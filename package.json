{
  "name": "licitaradar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "db:generate": "dotenv run -f .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv run -f .env.local -- drizzle-kit migrate",
    "db:push": "dotenv run -f .env.local -- drizzle-kit push",
    "db:seed": "dotenv run -f .env.local -- tsx src/db/seed.ts",
    "db:studio": "dotenv run -f .env.local -- drizzle-kit studio",
    "db:reset": "npm run db:migrate && npm run db:seed",
    "sync:pncp": "dotenv run -f .env.local -- tsx src/scripts/sync-pncp.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
